    <!-- Health profile tab -->
    <string name="health_profile_title">Battery Health (Measured)</string>
    <string name="health_formula_base">Current capacity / design capacity · [%1$s + %2$s]</string>
    <string name="health_formula_regression">Current capacity / design capacity · [%1$s·%2$s + %3$s]</string>
    <string name="health_unmeasurable_big">Unmeasurable</string>
    <string name="health_unmeasurable_note">Gauge node (%1$s) does not report charge_full — health = current capacity / design capacity; nothing is fabricated when unmeasurable</string>
    <string name="health_calibration_title">Full-Charge Calibration Specification</string>
    <string name="health_calibration_body_cv">Why is 100% not fully charged? To improve user experience, Android power management usually switches the UI to 100% early in the constant-voltage (CV) phase — hundreds of mA still flow in (saturated float charging), so the cell is not truly full.</string>
    <string name="health_calibration_body_cutoff">0-25 mA cutoff threshold: per the lithium-ion charge termination standard, full saturation is reached only when charging current decays naturally to 0.005C (0-25 mA). The capacity measured at that point is the most accurate and is committed by the fuel gauge as the full-charge capacity.</string>
    <string name="health_advice_title">Health Diagnostics</string>
    <string name="advice_overheat">The system reports battery overheating. Stop charging and remove the heat source immediately, then re-check at room temperature</string>
    <string name="advice_dead">The system reports a damaged battery. Have the cell inspected and replaced through authorized service</string>
    <string name="advice_over_voltage">The system reports cell over-voltage. Disconnect the charger, avoid further fast charging and have it serviced soon</string>
    <string name="advice_high_temp">Currently above %1$d°C: heat accelerates cell aging. Pause heavy loads and fast charging</string>
    <string name="advice_warm_temp">Currently %1$d-%2$d°C (warm): remove the protective case and avoid heavy use while charging</string>
    <string name="advice_cycle_worn">Cycle count exceeds %1$d (Li-poly 80%% health baseline ≈800 cycles): watch for capacity fade and consider replacement</string>
    <string name="advice_low_health">Measured health %1$s%% is below the 80%% baseline: evident battery aging; plan a replacement</string>
    <string name="advice_unmeasurable">The gauge node reports no capacity data, so health cannot be measured — other telemetry (voltage/current/temperature) are real readings</string>
    <string name="advice_normal">All hardware metrics are within the normal range; keep up good charging habits</string>

