generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String            @id @default(uuid())
  email          String            @unique
  password       String
  name           String
  avatar         String?
  phone          String?
  pets           Pet[]
  bookmarks      ManualBookmark[]
  subscriptions  Subscription[]
  notificationTokens NotificationToken[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

model Pet {
  id              String           @id @default(uuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  avatar          String?
  type            PetType
  breed           String?
  gender          PetGender
  birthday        DateTime?
  weight          Float?
  color           String?
  characteristics String?
  healthStatus    HealthStatus     @default(GOOD)
  healthRecords   HealthRecord[]
  healthMetrics   HealthMetricsData[]
  vaccines        PetVaccine[]
  checkups        PetCheckup[]
  growthRecords   PetGrowth[]
  reminders       Reminder[]
  conversations   AIConversation[]
  bondScores      BondScore[]
  emotionAnalyses EmotionAnalysis[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model HealthRecord {
  id             String        @id @default(uuid())
  petId          String
  pet            Pet           @relation(fields: [petId], references: [id], onDelete: Cascade)
  type           RecordType
  title          String
  content        String
  tags           String[]
  attachments    String[]
  voiceDuration  Int?
  isImportant    Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model PetVaccine {
  id        String   @id @default(uuid())
  petId     String
  pet       Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  name      String
  date      DateTime
  nextDate  DateTime?
  vet       String?
  notes     String?
  createdAt DateTime @default(now())
}

model PetCheckup {
  id          String   @id @default(uuid())
  petId       String
  pet         Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  date        DateTime
  weight      Float?
  vet         String?
  notes       String?
  attachments String[]
  createdAt   DateTime @default(now())
}

model PetGrowth {
  id        String   @id @default(uuid())
  petId     String
  pet       Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  date      DateTime
  weight    Float?
  height    Float?
  notes     String?
  createdAt DateTime @default(now())
}

model Reminder {
  id          String       @id @default(uuid())
  petId       String
  pet         Pet          @relation(fields: [petId], references: [id], onDelete: Cascade)
  type        ReminderType
  title       String
  notes       String?
  date        DateTime
  time        String
  repeat      RepeatType
  endDate     DateTime?
  isCompleted Boolean      @default(false)
  completedAt DateTime?
  createdAt   DateTime     @default(now())
}

model AIConversation {
  id        String   @id @default(uuid())
  petId     String
  pet       Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  userId    String
  messages  Json[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HealthManual {
  id          String           @id @default(uuid())
  title       String
  content     String
  category    ManualCategory
  petType     PetType?
  tags        String[]
  author      String?
  viewCount   Int              @default(0)
  isOfficial  Boolean          @default(true)
  bookmarks   ManualBookmark[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model ManualBookmark {
  id        String        @id @default(uuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  manualId  String
  manual    HealthManual  @relation(fields: [manualId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())
}

// ==================== 新增模型 ====================

model CameraDevice {
  id             String        @id @default(uuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  model          String
  manufacturer   String?
  protocol       CameraProtocol @default(RTSP)
  rtspUrl        String?
  webrtcUrl      String?
  streamUrl      String?
  status         DeviceStatus  @default(OFFLINE)
  location       String?
  capabilities   Json          @default("[]")
  settings       Json          @default("{}")
  lastOnline     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model HealthMetricsData {
  id        String   @id @default(uuid())
  petId     String
  pet       Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  type      String
  value     String
  unit      String
  timestamp DateTime @default(now())
  source    String   @default("device")
}

model BondScore {
  id        String   @id @default(uuid())
  petId     String
  pet       Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  score     Int
  dimension String
  note      String?
  date      DateTime @default(now())
  createdAt DateTime @default(now())
}

model EmotionAnalysis {
  id        String   @id @default(uuid())
  petId     String
  pet       Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  emotion   String
  confidence Float
  imageUrl  String?
  audioUrl  String?
  details   Json?
  createdAt DateTime @default(now())
}

model SmartFeeder {
  id           String       @id @default(uuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  deviceType   DeviceType   @default(FEEDER)
  macAddress   String?
  bluetoothId  String?
  status       DeviceStatus @default(OFFLINE)
  settings     Json         @default("{}")
  lastOnline   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Subscription {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan      SubscriptionPlan @default(FREE)
  status    SubStatus        @default(ACTIVE)
  startDate DateTime         @default(now())
  endDate   DateTime?
  autoRenew Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model InsurancePlan {
  id          String   @id @default(uuid())
  name        String
  provider    String
  coverage    String
  price       Float
  petType     PetType?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model NotificationToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String   @default("android")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==================== 枚举 ====================

enum PetType {
  DOG
  CAT
  OTHER
}

enum PetGender {
  MALE
  FEMALE
}

enum HealthStatus {
  EXCELLENT
  GOOD
  FAIR
  CONCERN
}

enum RecordType {
  TEXT
  VOICE
  PHOTO
  VIDEO
  FILE
}

enum ReminderType {
  VACCINE
  DEWORMING
  CHECKUP
  BATH
  BRUSH_TEETH
  MEDICINE
  GROOMING
  CUSTOM
}

enum RepeatType {
  ONCE
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum ManualCategory {
  NUTRITION
  CARE
  BEHAVIOR
  EMERGENCY
  TRAINING
}

enum CameraProtocol {
  RTSP
  ONVIF
  WEBRTC
  HLS
}

enum DeviceStatus {
  ONLINE
  OFFLINE
  CONNECTING
  ERROR
}

enum DeviceType {
  FEEDER
  FOUNTAIN
  LASER
  WEARABLE
}

enum SubscriptionPlan {
  FREE
  PRO
  PREMIUM
}

enum SubStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}
